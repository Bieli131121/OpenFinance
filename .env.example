# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Open Finance — deixe "mock" até configurar um provider real
OPEN_FINANCE_PROVIDER=mock

# Leitura de boleto por foto (IA de visão). Só no servidor — NUNCA use NEXT_PUBLIC_.
# Sem a chave, a tela de boletos continua funcionando digitando a linha digitável.
ANTHROPIC_API_KEY=
# Opcional: modelo usado na leitura (padrão: claude-sonnet-5-5)
ANTHROPIC_MODEL=

# Opcional: domínios extras autorizados a chamar Server Actions (separe por vírgula).
# Normalmente vazio. NUNCA use "*".
SERVER_ACTIONS_ALLOWED_ORIGINS=
